# Job Scout engine — environment variables
# Copy to .env for local use, or set these in Railway's Variables tab.
# Never commit a filled-in copy: .env is gitignored, .env.example is not.

# --- Required -------------------------------------------------------------

# Protects every route that can spend money or read results. If unset, those
# routes return 503 rather than serving openly. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JOBSCOUT_API_KEY=

# Scoring (Haiku) and application texts (Sonnet).
ANTHROPIC_API_KEY=

# --- Required only if a paid connector is enabled -------------------------

# LinkedIn and InfoJobs. Not needed when every Apify source is disabled or
# replaying a saved dump.
APIFY_TOKEN=

# --- Browser access -------------------------------------------------------

# Comma-separated origins allowed to call this API from a browser. Lovable
# runs on its own domain, so it must be listed. Unset blocks browser calls
# entirely (server-to-server calls are unaffected).
# Example: https://my-app.lovable.app,https://my-app.lovableproject.com
ALLOWED_ORIGINS=

# --- Persistence ----------------------------------------------------------

# "json" (default) or "supabase".
# json writes to disk, which is EPHEMERAL on Railway: results vanish on
# redeploy. Fine for a first smoke test, not for real use.
STORE_BACKEND=json

# Where JsonStore writes, when STORE_BACKEND=json.
STORE_DIR=./store_data

# Used when STORE_BACKEND=supabase. The service-role key bypasses RLS and must
# never reach the frontend — see ARCHITECTURE.md section 9.1.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alternative to the service-role key, paired with a user access token.
SUPABASE_ANON_KEY=
